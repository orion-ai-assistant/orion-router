# ===========================================================================
# Orion Router Servisi - Ortam Değişkenleri Örneği (.env.example)
# ===========================================================================

# --- Router (bu servis) ---
ROUTER_HOST=0.0.0.0
# Legacy alias only; the listener uses ORION_ROUTER_TLS_PORT below.
ROUTER_PORT=9443
ORION_ROUTER_TLS_HOST=0.0.0.0
ORION_ROUTER_TLS_PORT=9443
# Local browser only, fixed loopback bind; never advertised to the LAN.
ORION_ROUTER_LOCAL_HTTP_PORT=20128
# Keep this directory/volume across restarts; deleting the key requires re-pairing.
# ORION_ROUTER_TLS_DIRECTORY=persistent/tls
# Yerel geliştirme TLS portu; ayarlanmazsa 9444 kullanılır.
ORION_ROUTER_TLS_DEV_PORT=9444
# Next.js dev sunucusu portu.
UI_PORT=3001

# LAN discovery (native defaults on; container defaults off)
# ORION_ROUTER_MDNS=1
# Default hostname: orionrouter-<installation UUID without hyphens>.local
# ORION_ROUTER_MDNS_HOSTNAME=orionrouter-my-installation.local
# Default name: <computer name> — Orion Router; changing it preserves identity.
# ORION_ROUTER_MDNS_NAME=Home PC — Orion Router
# ORION_ROUTER_MDNS_INTERFACES=Wi-Fi,Ethernet
# ORION_ROUTER_MDNS_ID_FILE=persistent/mdns-id

# --- CLI / Terminal Dili ---
# Terminal çıktılarının dili (örneğin: "tr", "en"). Yükleyici tarafından sistem dilinden otomatik algılanır.
# CLI_LANG=en


# --- Yerel Servis Adresleri ---
LLM_HOST=127.0.0.1
LLM_PORT=8085

# Folder containing ffmpeg and ffprobe (empty = PATH). Video frames are decoded locally.
FFMPEG_DIR=

EMBED_HOST=127.0.0.1
EMBED_PORT=8086

TTS_HOST=127.0.0.1
TTS_PORT=8810

STT_HOST=127.0.0.1
STT_PORT=9009

# --- Admin Paneli ---
# Sağlayıcı API anahtarları .env'de tutulmaz; Dashboard → Key Pool üzerinden eklenir.
# Router admin paneli (/admin) için kimlik doğrulama anahtarı (X-Admin-Key başlığı ile gönderilir)
ADMIN_SECRET=orion

# --- Veritabanı (PostgreSQL) ---
# Docker Compose: router-db
# Native Dev/Prod (dev.ps1 / prod.ps1): localhost
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DEV_PORT=5444
POSTGRES_DB=orion_router
POSTGRES_USER=router_user
POSTGRES_PASSWORD=router_pass


# --- Dashboard UI ---
DASHBOARD_OUT_DIR=dashboard/out

# --- App Identification Headers ---
# OpenRouter (and other providers) demand HTTP-Referer and X-Title headers to show your app name and icon.
APP_REFERER=https://orion-ai-assistant.github.io/orion-router
APP_TITLE="Orion Router"
APP_CATEGORIES="cli-agent,cloud-agent"
